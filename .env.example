# HelpMesh Environment Variables for Vercel Deployment

# Privy App ID for Account Abstraction & Social Connects (Google, X, Facebook, Rabby, MetaMask)
NEXT_PUBLIC_PRIVY_APP_ID="cmvkxc8s5003c0igtyy0iatfz"

# Set to "false" to interact with on-chain Base contracts (default is live on Base)
